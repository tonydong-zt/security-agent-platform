# ===== LLM Provider =====
# Supported values:
# - deepseek: use the DeepSeek-specific settings below.
# - openai_compatible: use LLM_API_KEY / LLM_BASE_URL / LLM_MODEL.
LLM_PROVIDER=deepseek

# Only fill these when LLM_PROVIDER=openai_compatible.
# Leave them empty when LLM_PROVIDER=deepseek.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60

# ===== DeepSeek Options =====
# Fill these when LLM_PROVIDER=deepseek.
# DeepSeek OpenAI-compatible base_url is normally:
# https://api.deepseek.com
# Fill DEEPSEEK_MODEL with a real model currently available to your account.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
DEEPSEEK_THINKING_ENABLED=true
DEEPSEEK_REASONING_EFFORT=high

# ===== Embedding =====
# Supported values:
# - gemini: recommended if you want to use Google Gemini's native embedding API.
# - openai_compatible: use a service that exposes an OpenAI-compatible /embeddings API.
# - local: use a local sentence-transformers model.
EMBEDDING_PROVIDER=gemini

# Only fill these when EMBEDDING_PROVIDER=openai_compatible.
# Leave them empty when EMBEDDING_PROVIDER=gemini or local.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# Only fill this when EMBEDDING_PROVIDER=local.
LOCAL_EMBEDDING_MODEL=

# ===== Gemini Embedding Options =====
# Fill these only when EMBEDDING_PROVIDER=gemini.
# GEMINI_EMBEDDING_MODEL must be a real embedding model available to your Google account.
# Example: gemini-embedding-001.
# Do not put Gemini native API URLs into EMBEDDING_BASE_URL.

GEMINI_EMBEDDING_MODEL=
GEMINI_EMBEDDING_TASK_TYPE=RETRIEVAL_DOCUMENT
GEMINI_EMBEDDING_OUTPUT_DIMENSION=

# ===== Vector DB =====
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=security_knowledge

# ===== Database =====
# Leave empty to use local SQLite fallback at ./data/security_agent.db.
# For PostgreSQL, use a real URL such as postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=

# ===== Optional SIEM Integration =====
SIEM_API_URL=
SIEM_API_KEY=
SIEM_VENDOR=
SIEM_VERIFY_SSL=true

# ===== Optional EDR Integration =====
EDR_API_URL=
EDR_API_KEY=
EDR_VENDOR=
EDR_VERIFY_SSL=true

# ===== Optional Firewall Integration =====
FIREWALL_API_URL=
FIREWALL_API_KEY=
FIREWALL_VENDOR=
FIREWALL_VERIFY_SSL=true

# ===== Optional Threat Intelligence =====
NVD_API_KEY=
CISA_KEV_SOURCE_URL=
MITRE_ATTACK_SOURCE_URL=
OWASP_SOURCE_URL=

# ===== Server Deployment =====
APP_ENV=development
# 0.0.0.0 means the backend listens on all network interfaces.
# Use a reverse proxy and HTTPS for production deployment.
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
